# Docker Compose local deployment
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_USER=novel
POSTGRES_PASSWORD=
POSTGRES_DB=ai_novel_first_step

# API
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Server configuration
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=

# Required by Docker Compose. The Web app uses it as a shared local-instance
# password, so browsers on the LAN cannot read another author's drafts.
# Generate a long random value, for example: openssl rand -hex 32
APP_ACCESS_TOKEN=

# Required by Docker Compose. This encrypts uploaded manuscripts and saved
# normalized text on disk. Keep it stable; changing it makes old files unreadable.
ANALYSIS_STORAGE_KEY=

# Browser-facing API URL used by the Next.js app.
# Keep this relative so production browsers call the web app proxy instead of localhost.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_BASE_URL=http://localhost:3001/api/v1
# Model-backed analysis requests can wait longer because some providers queue heavily.
# These defaults match the current code fallbacks: 10 minutes at the web proxy and API layers.
API_MODEL_PROXY_TIMEOUT_MS=600000
PROVIDER_REQUEST_TIMEOUT_MS=120000
PROVIDER_LENGTH_RETRY_MAX_OUTPUT_TOKENS=16384
BOOK_JOB_CONCURRENCY=4
# Local-only data lifecycle. Completed/failed jobs and uploads older than this
# are removed at API startup; uploaded TXT storage is also capped.
ANALYSIS_RETENTION_DAYS=30
ANALYSIS_STORAGE_MAX_MB=512
ANALYSIS_ARTIFACT_MAX_MB=512
# Optional custom directories (defaults to .local/ under cwd)
ANALYSIS_STORAGE_DIR=
ANALYSIS_ARTIFACT_DIR=

# Public site URL used for canonical metadata, robots.txt, sitemap.xml, and JSON-LD.
# Set this to your deployed Web URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional shared OpenAI-compatible model endpoint used by the "免费共享算力" preset.
# Leave blank to disable the shared endpoint and use your own model key in the UI.
SHARED_GPU_BASE_URL=
SHARED_GPU_MODEL=
SHARED_GPU_API_KEY=
SHARED_GPU_JSON_MODE=false

# Enable response_format=json_schema for OpenAI-compatible providers beyond official OpenAI/Azure OpenAI URLs.
# Keep false unless your provider explicitly supports JSON Schema structured outputs.
ENABLE_OPENAI_COMPAT_JSON_SCHEMA=false

# Database configuration
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_MS=10000
DRIZZLE_MIGRATIONS_FOLDER=./drizzle/migrations
PGLITE_DATA_DIR=

# Logging
LOGS_DIR=
